datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum BillingInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
  EXPIRED
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  OVERDUE
  VOID
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountApplicationStatus {
  APPLIED
  REVERTED
}

enum BillingRunStatus {
  STARTED
  COMPLETED
  FAILED
  PARTIAL
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  CASH
  STRIPE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// -------------------------------------------------------------
// USERS & CUSTOMERS
// -------------------------------------------------------------

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  firstName String
  lastName  String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      Customer?
  createdQuotes Quotation[] @relation("CreatedByUser")
  auditLogs     AuditLog[]

  @@map("users")
}

model Customer {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String?        @unique @db.Uuid
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyName     String?
  contactName     String
  email           String         @unique
  phone           String?
  billingAddress  String?
  shippingAddress String?
  taxNumber       String?
  status          CustomerStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  quotations           Quotation[]
  subscriptions        Subscription[]
  invoices             Invoice[]
  payments             Payment[]
  discountApplications DiscountApplication[]

  @@map("customers")
}

// -------------------------------------------------------------
// PRODUCTS & VARIANTS
// -------------------------------------------------------------

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  sku         String?  @unique
  salesPrice  Decimal  @default(0.00) @db.Decimal(12, 2)
  costPrice   Decimal  @default(0.00) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants  ProductVariant[]
  discounts DiscountProduct[]

  @@map("products")
}

model ProductVariant {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @db.Uuid
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  sku             String   @unique
  price           Decimal  @db.Decimal(12, 2) // Final / effective selling price
  costPrice       Decimal? @db.Decimal(12, 2) // Cost of goods sold / margin tracking
  priceAdjustment Decimal? @db.Decimal(12, 2) // Adjustment delta relative to Product.salesPrice
  attributes      Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptionItems SubscriptionItem[]
  quotationItems    QuotationItem[]
  invoiceItems      InvoiceItem[]

  @@map("product_variants")
}

// -------------------------------------------------------------
// SUBSCRIPTION PLANS
// -------------------------------------------------------------

model Plan {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  code            String          @unique
  description     String?
  billingInterval BillingInterval
  intervalCount   Int             @default(1)
  price           Decimal         @db.Decimal(12, 2)
  currency        String          @default("USD")
  trialDays       Int             @default(0)
  minQuantity     Int             @default(1)
  availableFrom   DateTime?
  availableTo     DateTime?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions  Subscription[]
  quotationItems QuotationItem[]
  discounts      DiscountPlan[]

  @@map("plans")
}

// -------------------------------------------------------------
// TAXES & DISCOUNTS
// -------------------------------------------------------------

model Tax {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  rate        Decimal  @db.Decimal(5, 2)
  description String?
  isCompound  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("taxes")
}

model Discount {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String
  code               String       @unique
  type               DiscountType @default(PERCENTAGE)
  value              Decimal      @db.Decimal(12, 2)
  minPurchaseAmount  Decimal?     @db.Decimal(12, 2)
  minQuantity        Int?
  maxUsesPerCustomer Int?
  validFrom          DateTime?
  validTo            DateTime?
  maxUses            Int?
  usedCount          Int          @default(0)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  eligibleProducts DiscountProduct[]
  eligiblePlans    DiscountPlan[]
  applications     DiscountApplication[]

  @@map("discounts")
}

model DiscountProduct {
  id         String   @id @default(uuid()) @db.Uuid
  discountId String   @db.Uuid
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([discountId, productId])
  @@map("discount_products")
}

model DiscountPlan {
  id         String   @id @default(uuid()) @db.Uuid
  discountId String   @db.Uuid
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  planId     String   @db.Uuid
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([discountId, planId])
  @@map("discount_plans")
}

model DiscountApplication {
  id            String                    @id @default(uuid()) @db.Uuid
  discountId    String                    @db.Uuid
  discount      Discount                  @relation(fields: [discountId], references: [id], onDelete: Restrict)
  customerId    String                    @db.Uuid
  customer      Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId     String?                   @db.Uuid
  invoice       Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  quotationId   String?                   @db.Uuid
  quotation     Quotation?                @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  appliedAmount Decimal                   @db.Decimal(12, 2)
  status        DiscountApplicationStatus @default(APPLIED)
  appliedAt     DateTime                  @default(now())

  @@map("discount_applications")
}

// -------------------------------------------------------------
// QUOTATIONS
// -------------------------------------------------------------

model Quotation {
  id             String          @id @default(uuid()) @db.Uuid
  quotationNumber String         @unique
  customerId     String          @db.Uuid
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdById    String          @db.Uuid
  createdBy      User            @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: Restrict)
  status         QuotationStatus @default(DRAFT)
  issueDate      DateTime        @default(now())
  validUntil     DateTime
  subtotal       Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)
  notes          String?
  terms          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  convertedSubscriptionId String?       @unique @db.Uuid
  convertedSubscription   Subscription? @relation("QuotationToSubscription", fields: [convertedSubscriptionId], references: [id], onDelete: SetNull)

  items                QuotationItem[]
  invoices             Invoice[]
  discountApplications DiscountApplication[]

  @@map("quotations")
}

model QuotationItem {
  id             String          @id @default(uuid()) @db.Uuid
  quotationId    String          @db.Uuid
  quotation      Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description    String
  variantId      String?         @db.Uuid
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  planId         String?         @db.Uuid
  plan           Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(12, 2)
  taxRate        Decimal         @default(0.00) @db.Decimal(5, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())

  @@map("quotation_items")
}

// -------------------------------------------------------------
// SUBSCRIPTIONS
// -------------------------------------------------------------

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  subscriptionNumber String             @unique
  customerId         String             @db.Uuid
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId             String             @db.Uuid
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(ACTIVE)
  billingInterval    BillingInterval
  startDate          DateTime           @default(now())
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  nextBillingDate    DateTime
  endDate            DateTime?
  autoRenew          Boolean            @default(true)
  pausedAt           DateTime?
  resumedAt          DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  convertedFromQuotation Quotation?         @relation("QuotationToSubscription")
  items                  SubscriptionItem[]
  invoices               Invoice[]

  @@map("subscriptions")
}

model SubscriptionItem {
  id             String         @id @default(uuid()) @db.Uuid
  subscriptionId String         @db.Uuid
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variantId      String         @db.Uuid
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity       Int            @default(1)
  unitPrice      Decimal        @db.Decimal(12, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("subscription_items")
}

// -------------------------------------------------------------
// BILLING RUNS
// -------------------------------------------------------------

model BillingRun {
  id                     String           @id @default(uuid()) @db.Uuid
  runDate                DateTime         @default(now())
  targetBillingDate      DateTime
  status                 BillingRunStatus @default(STARTED)
  subscriptionsEvaluated Int              @default(0)
  invoicesGenerated      Int              @default(0)
  totalAmountBilled      Decimal          @default(0.00) @db.Decimal(12, 2)
  executionTimeMs        Int?
  errorLog               Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  invoices Invoice[]

  @@map("billing_runs")
}

// -------------------------------------------------------------
// INVOICES & RECURRING BILLING
// -------------------------------------------------------------

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  invoiceNumber      String        @unique
  customerId         String        @db.Uuid
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscriptionId     String?       @db.Uuid
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  quotationId        String?       @db.Uuid
  quotation          Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  billingRunId       String?       @db.Uuid
  billingRun         BillingRun?   @relation(fields: [billingRunId], references: [id], onDelete: SetNull)
  status             InvoiceStatus @default(ISSUED)
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  subtotal           Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount          Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  amountPaid         Decimal       @default(0.00) @db.Decimal(12, 2)
  amountDue          Decimal       @db.Decimal(12, 2)
  paidAt             DateTime?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items                InvoiceItem[]
  allocations          PaymentAllocation[]
  discountApplications DiscountApplication[]

  // Ensures duplicate recurring invoices cannot be generated for the exact same subscription billing period
  @@unique([subscriptionId, billingPeriodStart, billingPeriodEnd], name: "unique_recurring_subscription_period")
  @@map("invoices")
}

model InvoiceItem {
  id             String          @id @default(uuid()) @db.Uuid
  invoiceId      String          @db.Uuid
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  variantId      String?         @db.Uuid
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(12, 2)
  taxRate        Decimal         @default(0.00) @db.Decimal(5, 2) // Frozen tax-rate snapshot
  taxAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())

  @@map("invoice_items")
}

// -------------------------------------------------------------
// PAYMENTS & ALLOCATIONS
// -------------------------------------------------------------

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  paymentNumber        String        @unique
  customerId           String        @db.Uuid
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod @default(CREDIT_CARD)
  status               PaymentStatus @default(COMPLETED)
  transactionReference String?
  paymentDate          DateTime      @default(now())
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  allocations PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @db.Uuid
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId   String   @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount      Decimal  @db.Decimal(12, 2)
  allocatedAt DateTime @default(now())

  @@map("payment_allocations")
}

// -------------------------------------------------------------
// AUDIT LOG
// -------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
