# ==============================================================
# Brightloop Subscription Management System - Environment Config
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# Password Hashing
BCRYPT_SALT_ROUNDS=10

# Database Connection (PostgreSQL - Managed by Member 3)
DATABASE_URL=postgresql://user:password@localhost:5432/brightloop?schema=public
