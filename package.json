{
  "name": "brightloop-backend",
  "version": "1.0.0",
  "description": "Backend foundation and core APIs for Brightloop Subscription Management System",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node tests/foundation.test.js",
    "test:billing": "node tests/billing.test.js",
    "test:health": "node -e \"fetch('http://localhost:5000/api/v1/health').then(r=>r.json()).then(console.log).catch(console.error)\"",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "seed": "node prisma/seed.js",
    "prisma:studio": "npx prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "brightloop",
    "subscription-management",
    "express",
    "jwt",
    "zod",
    "prisma",
    "postgresql"
  ],
  "author": "Brightloop Team (Member 2 - Backend Core)",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "^5.22.0"
  }
}
